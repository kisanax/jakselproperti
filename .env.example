# =============================================================================
# jakselproperti.com — Environment Variables Template
# =============================================================================

# Database (MySQL - Laragon local / Production)
DATABASE_URL="mysql://root:@localhost:3306/jakselproperti"

# Auth.js / Google OAuth
# Generate a strong random value for AUTH_SECRET in every environment.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production / staging: https://dreamshop.my.id
AUTH_URL="http://localhost:3000"

# Storage
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"

# Cloudflare R2 (Optional - for production)
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=jakselproperti-dev
# R2_PUBLIC_URL=
