// =============================================================================
// jakselproperti.com — Database Schema
// Based on Blueprint v0.3
// Provider: MySQL (Laragon local dev / Production)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// SEQUENCE COUNTERS (untuk penomoran publik Property & Listing)
// =============================================================================

/// Counter independen untuk penomoran publik.
/// Increment dilakukan secara atomic via row lock dalam transaksi.
model SequenceCounter {
  name         String @id @db.VarChar(50)
  currentValue BigInt @default(0) @map("current_value")

  @@map("sequence_counters")
}

// =============================================================================
// ENUMS
// =============================================================================

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  SHOPHOUSE
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  READY_TO_PUBLISH
  ACTIVE
  IN_NEGOTIATION
  SOLD
  SUSPENDED
  WITHDRAWN
  EXPIRED
  ARCHIVED
}

enum CertificateType {
  SHM // Sertifikat Hak Milik
  SHGB // Sertifikat Hak Guna Bangunan
  SHSRS // Sertifikat Hak Satuan Rumah Susun
  AJB // Akta Jual Beli
  GIRIK // Girik/Letter C
  PPJB // Perjanjian Pengikatan Jual Beli
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
  FLOOR_PLAN
}

enum DocumentType {
  CERTIFICATE
  IDENTITY
  POWER_OF_ATTORNEY
  CONSIGNMENT_AGREEMENT
  COMMUNICATION_PROOF
  LEGAL_OTHER
}

enum DocumentStatus {
  NOT_AVAILABLE
  AVAILABLE
  VERIFIED
  EXPIRED
}

enum LeadStage {
  NEW // Baru
  QUALIFIED // Kualifikasi
  VIEWING // Survei
  NEGOTIATING // Negosiasi
  WON // Closing - Menang
  LOST // Closing - Hilang
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TrustLevel {
  NEW
  VERIFIED
  TRUSTED
  BLACKLISTED
}

enum IntermediaryRole {
  PRIMARY_SOURCE
  SECONDARY_SOURCE
  REFERRER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

enum PlatformRole {
  MEMBER
  SUPER_ADMIN
  SUPPORT
  BROKER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum BrokerType {
  INDEPENDENT
  AGENCY_OWNER
  AGENCY_MEMBER
}

enum BrokerVerificationStatus {
  PROFILE_INCOMPLETE
  PENDING_REVIEW
  REVISION_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
}

// =============================================================================
// ACCESS & AUTH
// =============================================================================

/// Identitas platform. Organisasi, cabang, dan role organisasi ditautkan
/// melalui membership pada fase berikutnya, bukan langsung pada tabel user.
model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  emailVerified DateTime?
  name          String?
  image         String?      @db.VarChar(1000)
  password      String? // null untuk akun OAuth
  platformRole  PlatformRole @default(MEMBER)
  isActive      Boolean      @default(true)
  deletedAt     DateTime? // soft delete — tetap tersimpan untuk audit, tidak bisa login
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  accounts               Account[]
  sessions               Session[]
  brokerProfile          BrokerProfile?
  auditLogs              AuditLog[]
  notificationPreferences NotificationPreference[]
  listingStatusChanges   ListingStatusHistory[]
  priceChanges           PriceHistory[]
  leadActivities         LeadActivity[]
  managedListings        Listing[] @relation("ListingManagedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model BrokerProfile {
  id                    String                   @id @default(uuid())
  userId                String                   @unique
  brokerType            BrokerType?
  phone                 String?                  @db.VarChar(40)
  city                  String?                  @db.VarChar(120)
  province              String?                  @db.VarChar(120)
  licenseNumber         String?                  @db.VarChar(120)
  bio                   String?                  @db.Text
  verificationStatus    BrokerVerificationStatus @default(PROFILE_INCOMPLETE)
  onboardingCompletedAt DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([city, province])
  @@map("broker_profiles")
}

/// Konfigurasi modul mana yang aktif per role — diedit SUPER_ADMIN
/// lewat halaman Konfigurasi Akses. Fallback ke default di lib/module-access.ts
/// bila baris belum ada (misal sebelum seed).
model RoleModuleAccess {
  id        String       @id @default(uuid())
  role      PlatformRole
  moduleKey String       @db.VarChar(50)
  enabled   Boolean      @default(false)
  updatedAt DateTime     @updatedAt

  @@unique([role, moduleKey])
  @@map("role_module_access")
}

/// Preferensi notifikasi per user, per event, per channel.
/// Absennya baris = memakai default dari katalog event (lib/notifications.ts).
model NotificationPreference {
  id      String             @id @default(uuid())
  userId  String
  eventKey String            @db.VarChar(50)
  channel NotificationChannel @default(IN_APP)
  enabled Boolean            @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey, channel])
  @@index([userId])
  @@map("notification_preferences")
}

/// Log aktivitas admin — setiap aksi penting dicatat
model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  action     AuditAction
  entityType String // e.g. "property", "listing", "owner"
  entityId   String
  details    Json? // snapshot perubahan
  ipAddress  String?
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// AREA & KAWASAN (STRUKTUR 2-LAYER — Section 15.3)
// =============================================================================

/// Wilayah administratif nasional (hierarki Kemendagri 4 level).
/// Data katalog statis 91 ribu baris — primary key Int autoincrement
/// (bukan UUID) demi ukuran tabel & index yang ramping.
/// Data Jaksel dikurasi seed; data nasional via importer wilayah.
model Area {
  id           Int      @id @default(autoincrement())
  name         String // e.g. "Kebayoran Baru", "Kota Administrasi Jakarta Selatan"
  slug         String   @unique
  code         String?  @unique // LEGACY kode singkatan huruf — tidak dipakai untuk kode properti lagi
  officialCode String?  @unique @db.VarChar(13) // kode wilayah Kemendagri, e.g. "31.74.01"
  parentId     Int? // null = provinsi (level 1); kecamatan → kab/kota; kelurahan → kecamatan
  level        Int      @default(3) // 1 = provinsi, 2 = kab/kota, 3 = kecamatan, 4 = kelurahan/desa
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parent     Area?      @relation("AreaHierarchy", fields: [parentId], references: [id])
  children   Area[]     @relation("AreaHierarchy")
  kawasan    Kawasan[]
  properties Property[] @relation("PropertyKecamatan")
  villageProperties Property[] @relation("PropertyVillage")

  @@index([parentId])
  @@index([level])
  @@index([slug])
  @@map("areas")
}

/// Kawasan populer / branded (Kemang, Senopati, Pondok Indah, dll)
/// Terhubung ke kecamatan induk lewat areaId (Section 15.3)
/// Ditampilkan sebagai banner promosi di homepage ("Kawasan Pilihan") & landing page SEO
model Kawasan {
  id          String   @id @default(uuid())
  name        String // e.g. "Kemang", "Senopati", "Pondok Indah"
  slug        String   @unique
  code        String?  @unique // kode 3 huruf untuk kode properti (e.g. "KMG", "PDI")
  areaId      Int      // Terhubung ke kecamatan (level 3) induk kawasan
  tagline     String? // Tagline banner promo homepage
  bannerImage String? // URL/path foto banner kawasan
  isFeatured  Boolean  @default(false) // Toggle tampil di banner homepage
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  area       Area       @relation(fields: [areaId], references: [id])
  properties Property[]

  @@index([areaId])
  @@index([isFeatured])
  @@index([slug])
  @@map("kawasan")
}

// =============================================================================
// PIHAK TERKAIT (INTERNAL)
// =============================================================================

/// Pemilik properti — data bersifat internal
model Owner {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  idNumber  String? // KTP/passport — encrypted at rest nanti
  address   String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  propertyOwners PropertyOwner[]

  @@index([name])
  @@index([phone])
  @@map("owners")
}

/// Perantara/broker — pembawa info properti ke tim dengan Trust Level (Section 5 & 15.1)
model Intermediary {
  id         String     @id @default(uuid())
  name       String
  phone      String?
  email      String?
  company    String? // nama kantor broker jika ada
  trustLevel TrustLevel @default(NEW)
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  listingIntermediaries ListingIntermediary[]

  @@index([name])
  @@index([phone])
  @@index([trustLevel])
  @@map("intermediaries")
}

// =============================================================================
// PROPERTI (ASET FISIK)
// =============================================================================

/// Properti — aset fisik yang tidak berubah karena status pemasaran
/// Satu properti bisa punya beberapa riwayat listing (Section 6)
model Property {
  id             String       @id @default(uuid())
  code           String       @unique // kode properti numerik: {kode Kemendagri kecamatan}-{running}, cth. "317407-0001"
  propertyNumber String?      @unique @map("property_number") @db.VarChar(20) // Nomor publik "100001-7"
  type      PropertyType
  areaId    Int      // Kecamatan (level 3) — administratif
  villageId Int?     // Kelurahan/desa (level 4) — opsional, harus anak dari areaId
  kawasanId String? // Kawasan populer / branded (opsional marketing)

  // Lokasi (internal)
  address   String   @db.Text // alamat lengkap — internal only
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Spesifikasi
  landArea     Int? // m²
  buildingArea Int? // m²
  bedrooms     Int?
  bathrooms    Int?
  floors       Int? @default(1)
  garages      Int? @default(0)
  carports     Int? @default(0)

  // Sertifikat
  certificateType CertificateType?
  certificateNo   String? // internal only

  // Bangunan
  yearBuilt   Int?
  facing      String? // Utara, Selatan, dll
  electricity Int? // watt
  waterSource String? // PAM, sumur, dll

  // Internal
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  area           Area              @relation("PropertyKecamatan", fields: [areaId], references: [id])
  village        Area?             @relation("PropertyVillage", fields: [villageId], references: [id])
  kawasan        Kawasan?          @relation(fields: [kawasanId], references: [id])
  listings       Listing[]
  propertyOwners PropertyOwner[]
  propertyMedia  PropertyMedia[]
  documents      Document[]
  auctionRecords AuctionRecord[]
  amenities      PropertyAmenity[]

  @@index([areaId])
  @@index([villageId])
  @@index([kawasanId])
  @@index([type])
  @@index([code])
  @@map("properties")
}

// Flexible internal intake for Jabodetabek; optional link to the verified asset.
// Each record represents one marketing/auction period, including repeat auctions.
model AuctionRecord {
  id              String    @id @default(uuid())
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title           String    @db.VarChar(255)
  category        String    @default("AUCTION") @db.VarChar(32)
  propertyType    String    @default("HOUSE") @db.VarChar(32)
  city            String?   @db.VarChar(120)
  district        String?   @db.VarChar(120)
  address         String?   @db.Text
  description     String?   @db.Text
  specifications  String?   @db.Text
  limitPrice      Decimal?  @db.Decimal(15, 0)
  depositAmount   Decimal?  @db.Decimal(15, 0)
  seller          String?   @db.VarChar(255)
  organizer       String?   @db.VarChar(255)
  contactName     String?   @db.VarChar(255)
  contactPhone    String?   @db.VarChar(80)
  sourceUrl       String?   @db.VarChar(1000)
  sourceText      String?   @db.Text
  termsNotes      String?   @db.Text
  status          String    @default("DRAFT") @db.VarChar(32)
  activeFrom      DateTime? @db.Date
  durationMonths  Int?
  activeUntil     DateTime? @db.Date
  auctionAt       DateTime?
  depositDeadline DateTime?
  resultNotes     String?   @db.Text
  photos          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([propertyId])
  @@index([status, activeUntil])
  @@index([city])
  @@map("auction_records")
}

/// Junction: Property ↔ Owner (many-to-many)
/// Satu properti bisa punya beberapa owner; satu owner bisa punya banyak properti
model PropertyOwner {
  id         String   @id @default(uuid())
  propertyId String
  ownerId    String
  isPrimary  Boolean  @default(false)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id])

  @@unique([propertyId, ownerId])
  @@index([ownerId])
  @@map("property_owners")
}

// =============================================================================
// LISTING (PERIODE PENAWARAN PENJUALAN)
// =============================================================================

/// Listing — satu periode/penawaran penjualan properti
/// Satu properti bisa punya beberapa listing di waktu berbeda (Section 6)
model Listing {
  id            String        @id @default(uuid())
  propertyId    String
  listingNumber String?       @unique @map("listing_number") @db.VarChar(20) // Nomor publik "500001-4"
  /// Pemilik/pengelola listing — dipakai scope data broker (Fase 2:
  /// broker hanya melihat listing yang dia kelola). Diisi otomatis dari
  /// user yang membuat listing; nullable untuk data warisan.
  managedById   String?
  status        ListingStatus @default(DRAFT)

  // Harga
  askingPrice    Decimal  @db.Decimal(15, 0) // Rp — harga yang ditawarkan
  minimumPrice   Decimal? @db.Decimal(15, 0) // Rp — harga minimum owner (internal)
  priceOnRequest Boolean  @default(false) // sembunyikan harga dari publik

  // Konten publik
  title           String? @db.VarChar(255)
  description     String? @db.Text // deskripsi publik
  showFullAddress Boolean @default(false) // per-listing basis (Section 15.1 #8)
  videoUrl        String? @db.VarChar(500) // URL YouTube / Instagram Reels / TikTok tour
  videoPlatform   String? @db.VarChar(50) // YOUTUBE, INSTAGRAM, TIKTOK, OTHER

  // Konsinyasi
  consignmentStartDate DateTime?
  consignmentEndDate   DateTime?
  consignmentNotes     String?   @db.Text

  // Internal
  internalNotes String?   @db.Text
  publishedAt   DateTime?
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id])
  managedBy             User?                  @relation("ListingManagedBy", fields: [managedById], references: [id])
  listingIntermediaries ListingIntermediary[]
  listingSources        ListingSource[]
  statusHistory         ListingStatusHistory[]
  priceHistory          PriceHistory[]
  leads                 Lead[]
  viewingSchedules      ViewingSchedule[]
  offers                Offer[]

  @@index([propertyId])
  @@index([managedById])
  @@index([status])
  @@index([askingPrice])
  @@index([createdAt])
  @@map("listings")
}

/// Junction: Listing ↔ Intermediary (many-to-many)
/// Dengan posisi dalam rantai dan info komisi (Section 5)
model ListingIntermediary {
  id              String           @id @default(uuid())
  listingId       String
  intermediaryId  String
  role            IntermediaryRole @default(PRIMARY_SOURCE)
  chainPosition   Int              @default(1) // posisi dalam rantai perantara
  commissionNotes String?          @db.Text // catatan komisi (MVP: belum breakdown)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())

  // Relations
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  intermediary Intermediary @relation(fields: [intermediaryId], references: [id])

  @@unique([listingId, intermediaryId])
  @@index([intermediaryId])
  @@map("listing_intermediaries")
}

/// Rantai sumber informasi properti (Section 5)
model ListingSource {
  id         String   @id @default(uuid())
  listingId  String
  sourceName String // nama sumber (bisa owner langsung atau perantara)
  sourceType String // "owner", "intermediary"
  sourceId   String? // reference ke owners/intermediaries ID
  receivedAt DateTime @default(now())
  notes      String?  @db.Text

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_sources")
}

// =============================================================================
// FASILITAS / AMENITIES
// =============================================================================

/// Fasilitas properti — master data
model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Kolam Renang", "Garasi", "Taman"
  slug      String   @unique
  icon      String? // lucide icon name
  category  String? // grouping: "Outdoor", "Interior", "Security", dll
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  properties PropertyAmenity[]

  @@map("amenities")
}

/// Junction: Property ↔ Amenity (many-to-many)
model PropertyAmenity {
  id         String @id @default(uuid())
  propertyId String
  amenityId  String

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id])

  @@unique([propertyId, amenityId])
  @@index([amenityId])
  @@map("property_amenities")
}

// =============================================================================
// MEDIA & DOKUMEN (SINGLE STORAGE: R2 — Section 11 & 12)
// =============================================================================

/// Foto, video, denah properti
/// Database hanya menyimpan metadata & path relatif — file di Cloudflare R2
model PropertyMedia {
  id         String    @id @default(uuid())
  propertyId String
  type       MediaType @default(PHOTO)

  // File info (relative path di R2)
  fileName String
  filePath String // relative path di storage (e.g. "properties/317407-0001/photo-1.webp")
  fileSize Int // bytes
  mimeType String
  width    Int? // pixels
  height   Int? // pixels
  fileHash String? // hash untuk deteksi duplikat foto

  // Thumbnails & variants
  thumbnailPath String? // path ke thumbnail
  webpPath      String? // path ke WebP version
  externalUrl   String? @db.VarChar(500) // URL embed eksternal jika ada (YouTube/Reels)
  duration      Int? // Durasi video dalam detik (jika tipe VIDEO)

  // Display
  sortOrder Int     @default(0) // urutan galeri
  isPrimary Boolean @default(false) // foto utama
  isPublic  Boolean @default(true) // tampil di publik
  altText   String? // SEO alt text
  caption   String?

  // Watermark (opsional per foto — Section 15.1 #9)
  hasWatermark Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isPrimary])
  @@index([sortOrder])
  @@map("property_media")
}

/// Referensi dokumen legal (Section 14)
/// MVP: hanya catat status/referensi, bukan file fisik (Section 15.1 #4)
model Document {
  id          String         @id @default(uuid())
  propertyId  String
  type        DocumentType
  status      DocumentStatus @default(NOT_AVAILABLE)
  referenceNo String? // nomor dokumen jika ada
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([type])
  @@map("documents")
}

// =============================================================================
// RIWAYAT
// =============================================================================

/// Riwayat perubahan status listing (Section 8)
model ListingStatusHistory {
  id         String         @id @default(uuid())
  listingId  String
  fromStatus ListingStatus?
  toStatus   ListingStatus
  changedBy  String // userId
  reason     String?        @db.Text
  createdAt  DateTime       @default(now())

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [changedBy], references: [id])

  @@index([listingId])
  @@index([createdAt])
  @@map("listing_status_history")
}

/// Riwayat perubahan harga listing
model PriceHistory {
  id        String   @id @default(uuid())
  listingId String
  oldPrice  Decimal  @db.Decimal(15, 0)
  newPrice  Decimal  @db.Decimal(15, 0)
  changedBy String // userId
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [changedBy], references: [id])

  @@index([listingId])
  @@index([createdAt])
  @@map("price_history")
}

// =============================================================================
// CRM / CUSTOMERS & LEADS (KANBAN — Section 15.4)
// =============================================================================

/// Calon pembeli unik — nomor HP sebagai kunci dedupe (Section 15.4)
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique // Kunci dedupe utama
  email     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  leads Lead[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

/// Lead — penghubung customer ↔ listing dengan kanban stage (Section 15.4)
/// Kolom kanban: Baru → Kualifikasi → Survei → Negosiasi → Closing (Menang / Hilang)
model Lead {
  id           String     @id @default(uuid())
  customerId   String
  listingId    String
  currentStage LeadStage  @default(NEW)
  source       LeadSource @default(WEBSITE)

  // Pesan inquiry
  message String? @db.Text

  // Internal
  notes    String? @db.Text
  priority Int     @default(0) // 0 = normal, 1 = high, 2 = urgent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer         Customer          @relation(fields: [customerId], references: [id])
  listing          Listing           @relation(fields: [listingId], references: [id])
  activities       LeadActivity[]
  viewingSchedules ViewingSchedule[]
  offers           Offer[]

  @@index([customerId])
  @@index([listingId])
  @@index([currentStage])
  @@index([createdAt])
  @@map("leads")
}

/// Log aktivitas & riwayat perpindahan stage kanban lead (Section 15.4)
model LeadActivity {
  id        String     @id @default(uuid())
  leadId    String
  userId    String // admin yang update
  fromStage LeadStage?
  toStage   LeadStage?
  type      String // "STAGE_CHANGE", "CALL", "WHATSAPP", "NOTE", "MEETING"
  summary   String?    @db.Text
  createdAt DateTime   @default(now())

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
  @@map("lead_activities")
}

/// Jadwal survei/viewing properti
model ViewingSchedule {
  id          String        @id @default(uuid())
  leadId      String
  listingId   String
  status      ViewingStatus @default(SCHEDULED)
  scheduledAt DateTime
  duration    Int?          @default(60) // menit
  location    String? // bisa beda dari alamat properti
  notes       String?       @db.Text
  feedback    String?       @db.Text // hasil survei
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([leadId])
  @@index([listingId])
  @@index([scheduledAt])
  @@map("viewing_schedules")
}

/// Penawaran harga dari calon pembeli
model Offer {
  id            String      @id @default(uuid())
  leadId        String
  listingId     String
  status        OfferStatus @default(PENDING)
  amount        Decimal     @db.Decimal(15, 0) // Rp
  counterAmount Decimal?    @db.Decimal(15, 0) // counter-offer dari owner
  notes         String?     @db.Text
  validUntil    DateTime? // berlaku sampai
  respondedAt   DateTime? // waktu respons
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([leadId])
  @@index([listingId])
  @@index([status])
  @@map("offers")
}
